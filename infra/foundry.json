{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "accountName": { "type": "string" },
    "location": { "type": "string", "defaultValue": "eastus2" },
    "principalId": { "type": "string" }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[parameters('accountName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "identity": { "type": "SystemAssigned" },
      "sku": { "name": "S0" },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[parameters('accountName')]",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[concat(parameters('accountName'), '/chess-trainer')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": ["[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"],
      "properties": {
        "displayName": "Chess Trainer",
        "description": "Screenshot-to-FEN recognition for the single-user Chess Trainer desktop app."
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-06-01",
      "name": "[concat(parameters('accountName'), '/chess-vision')]",
      "dependsOn": ["[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"],
      "sku": { "name": "GlobalStandard", "capacity": 10 },
      "properties": {
        "model": { "format": "OpenAI", "name": "gpt-4.1-mini", "version": "2025-04-14" },
        "versionUpgradeOption": "OnceCurrentVersionExpired",
        "raiPolicyName": "Microsoft.Default"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName')), parameters('principalId'), 'vision-user')]",
      "scope": "[concat('Microsoft.CognitiveServices/accounts/', parameters('accountName'))]",
      "dependsOn": ["[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '5e0bd9bd-7b93-4f28-af87-19fc36ad61bd')]",
        "principalId": "[parameters('principalId')]",
        "principalType": "User"
      }
    }
  ],
  "outputs": {
    "endpoint": { "type": "string", "value": "[concat('https://', parameters('accountName'), '.openai.azure.com/')]" },
    "deployment": { "type": "string", "value": "chess-vision" },
    "projectId": { "type": "string", "value": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('accountName'), 'chess-trainer')]" }
  }
}
